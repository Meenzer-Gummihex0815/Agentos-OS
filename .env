# Agentos-OS Umgebungsvariablen
# Lokale Entwicklungs-Konfiguration

# Server-Konfiguration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_DEBUG=True
SERVER_WORKERS=1

# CORS-Einstellungen
SERVER_CORS_ORIGINS=["*"]
SERVER_CORS_ALLOW_CREDENTIALS=True
SERVER_CORS_ALLOW_METHODS=["*"]
SERVER_CORS_ALLOW_HEADERS=["*"]

# Datenbank-Konfiguration
DB_URL=sqlite+aiosqlite:///./agentos.db
DB_ASYNC_URL=
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=False

# KI-Anbieter Konfiguration (für lokale Entwicklung ohne API-Keys)
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1

AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com

AI_GOOGLE_API_KEY=
AI_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

AI_MISTRAL_API_KEY=
AI_MISTRAL_BASE_URL=https://api.mistral.ai

AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Ollama (lokal)
AI_OLLAMA_BASE_URL=http://localhost:11434

# Standard-KI-Einstellungen
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4
AI_TIMEOUT=120
AI_MAX_RETRIES=3

# Agenten-Konfiguration
AGENT_MAX_AGENTS=50
AGENT_MAX_CONCURRENT_TASKS=10
AGENT_TASK_TIMEOUT=300
AGENT_MEMORY_RETENTION_DAYS=30
AGENT_DEFAULT_AGENTS=["researcher", "developer", "analyst", "writer", "orchestrator"]

# Sicherheits-Konfiguration
SECURITY_SECRET_KEY=DEV-SECRET-KEY-CHANGE-IN-PRODUCTION
SECURITY_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURITY_REFRESH_TOKEN_EXPIRE_DAYS=7
SECURITY_API_KEY_HEADER=X-API-Key
SECURITY_RATE_LIMIT_REQUESTS=100
SECURITY_RATE_LIMIT_PERIOD=60

# Monitoring-Konfiguration
MONITORING_ENABLED=True
MONITORING_PROMETHEUS_ENABLED=True
MONITORING_PROMETHEUS_PORT=9090
MONITORING_LOG_LEVEL=DEBUG
MONITORING_LOG_FORMAT=structured
MONITORING_LOG_FILE=agentos.log

# Projekt-Metadaten
PROJECT_NAME=Agentos-OS
PROJECT_VERSION=0.1.0
PROJECT_DESCRIPTION=Multi-Agenten-Betriebssystem für KI-Automatisierung
